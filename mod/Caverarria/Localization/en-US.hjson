Mods: {
	Caverarria: {
		Keybinds: {
			Interact.DisplayName: Cave Story: interact / advance dialogue
			Retry.DisplayName: Cave Story: retry from save
			SkipCutscene.DisplayName: Cave Story: hold to skip cutscene
			Inventory.DisplayName: Terraria inventory / close story item
			Map.DisplayName: Cave Story: map
			NextWeapon.DisplayName: Cave Story: next weapon
			PreviousWeapon.DisplayName: Cave Story: previous weapon
		}

		Configs: {
			CampaignViewConfig: {
				DisplayName: Caverarria

				Headers: {
					View: Camera and appearance
					Combat: Campaign combat
					Audio: Campaign audio
					Save: Campaign save
				}

				TerrariaWeaponDamageScale: {
					Label: Terraria weapon damage multiplier
					Tooltip: Scales Terraria weapon damage against Cave Story enemies. 1 is normal; 0 disables damage. Original Cave Story guns are unchanged.
				}

				EnemyDamageScale: {
					Label: Incoming campaign damage multiplier
					Tooltip: Scales Cave Story enemy and terrain damage before Terraria armor and hurt effects. 1 is normal; 0 disables damage.
				}

				MuteCampaignAudio: {
					Label: Mute Cave Story audio
					Tooltip: Mutes only Cave Story music and sound effects. Terraria's volume settings remain unchanged.
				}

				CampaignMusicVolume: {
					Label: Cave Story music volume
					Tooltip: Multiplies Terraria's music volume while in a Cave Story world.
				}

				CampaignSoundVolume: {
					Label: Cave Story sound effect volume
					Tooltip: Multiplies Terraria's sound volume for original Cave Story effects. Terraria weapon sounds follow Terraria's settings.
				}

				TerrariaSizedBlocks: {
					Label: Place Terraria-sized blocks
					Tooltip: When enabled, solid block items occupy one ordinary Terraria tile instead of a full Cave Story tile. Existing placed blocks retain their size. Small blocks share the campaign pixel grid.
				}

				PersistentTerrainEdits: {
					Label: Save terrain edits
					Tooltip: When enabled, mining, placed blocks and furniture survive retry and re-entry. When disabled, new edits last only until retry or leaving the world; already saved edits are preserved. Enabling this saves your current edits.
				}

				TerrainEdits: {
					Label: Terrain persistence
					Tooltip: Persistent: edits are saved as you make them and survive everything. Session: edits last until the room reloads (death, retry, re-entry); a campaign save commits them. Off: edits are never saved, so reloading always restores the authored room.
				}

				TerrainPersistence: {
					Persistent: {
						Label: Persistent
						Tooltip: Edits are saved immediately and survive reloads.
					}

					Session: {
						Label: Session
						Tooltip: Edits last until the room reloads; a campaign save commits them.
					}

					Off: {
						Label: Off
						Tooltip: Edits are never saved; reloading restores the authored room.
					}
				}

				ResetCurrentCampaign: {
					Label: Reset this world's Cave Story save
					Tooltip: Restarts this world's campaign and backs up its checkpoint. Requires confirmation in a running Cave Story world.
				}

				CameraPixelScale: {
					Label: Camera base pixel scale
					Tooltip: Larger values bring the camera closer. Terraria's world zoom slider and + / - adjust it in crisp pixel steps.
				}

				AmmoInInventorySlots: {
					Label: Show ammo in inventory slots
					Tooltip: On: show remaining Cave Story ammo on inventory and hotbar items, like Terraria ammo counts. Off: show remaining / maximum ammo below the XP bar. Applies to both missile launchers and other guns with limited ammo.
				}

				PlayerBodyScale: {
					Label: Player body size
					Tooltip: Scales your character and body collision together. Terrain can be mined to open tight passages; world pixels stay on the campaign grid.
				}
			}

			TerrainPersistence: {
				Tooltip: ""

				Persistent: {
					Label: Persistent
					Tooltip: ""
				}

				Session: {
					Label: Session
					Tooltip: ""
				}

				Off: {
					Label: Off
					Tooltip: ""
				}
			}
		}

		ConfigReset: {
			Title: Reset this world's Cave Story save
			Description: Start this world's campaign over. The old checkpoint is backed up; permanent Life Capsule upgrades stay with your character.
			Confirmation: Reset this world's story, weapons and items? Other worlds and your Terraria character's permanent health are preserved.
			Unavailable: Enter a Cave Story world to reset its campaign. This action affects only the world you are playing.
			Reset: Reset campaign...
			Confirm: Confirm reset
			Cancel: Cancel
			Resetting: Resetting campaign...
			Complete: Campaign restarted. The old checkpoint was backed up beside Profile.dat.
			FreshComplete: Campaign restarted. There was no saved checkpoint to back up.
			StartFailed: Checkpoint backed up. Campaign startup failed; leave and re-enter the world to try again.
			Cancelled: Reset cancelled because the current world changed.
			Failed: Reset failed. Your checkpoint or its backup was preserved; see the mod log for details.
		}

